    {
      "id": "json_extract",
      "group": "objective",
      "messages": [
        {
          "role": "user",
          "content": "请只输出 JSON，不要代码围栏。邮件内容：请在 2026-10-16 18:00 前补交报销材料，无需回复此邮件。字段固定为 task、deadline、needs_reply。task 请使用“补交报销材料”；deadline 格式 YYYY-MM-DD HH:MM。"
        }
      ],
      "expected": {
        "task": "补交报销材料",
        "deadline": "2026-10-16 18:00",
        "needs_reply": false
      },
      "category": "format"
    },
    {
      "id": "strict_boundary",
      "group": "objective",
      "messages": [
        {
          "role": "user",
          "content": "规则：金额严格超过 100 元才免邮，100 元整不免邮。请按 99.99、100、100.01 的顺序，只输出三个布尔值组成的 JSON 数组。"
        }
      ],
      "expected": [
        false,
        false,
        true
      ],
      "category": "reasoning"
    },
    {
      "id": "arithmetic",
