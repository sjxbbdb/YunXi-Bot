        "expected_revision"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "mac_mail_send",
    "capability": "outbound",
    "description": "把已核对的云熙本机草稿交给Mac Mail发送。必须先mac_mail_draft_get，用其revision；审批展示实际收件人、主题、正文及附件。request_id沿用，禁止不确定时换ID重复发送。handed_off仅表示Mail接受发送，不代表对方收到；任何状态不明先核对发件箱/已发送。 可用mac_mail_outbox按draft_id只读查询发送状态；该查询不会重发。",
    "parameters": {
      "type": "object",
      "properties": {
        "draft_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "expected_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "draft_id",
        "expected_revision",
        "request_id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "mac_document_read",
    "capability": "read_only",
    "description": "从本机附件副本提取文本，支持UTF-8文本与PDF；正文分页，必须读到next_offset=null才算完整。扫描PDF没有文字时如实说明，不执行宏或附件代码。此工具不读Mail私有数据库。",
    "parameters": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000000
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    }
  }
