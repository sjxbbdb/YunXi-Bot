# Rust 构建产物
/target/

# 运行数据（含台账，绝不入库）
data/
*.jsonl
*.db
*.db-journal
*.db-wal
*.db-shm

# 运行时锁与日志
# 注意放行 Cargo.lock——它是**依赖**锁，必须入库才能保证安装可复现
*.lock
!Cargo.lock
*.log

# 打包产物（模型 zip 约 356MB，只上传到 Release，绝不入库）
dist/

# Python 虚拟环境（含 torch，约 1GB，绝不入库）
.venv/
# 便携盘上的 Python 环境。`安装Python环境.cmd` 建在盘里（`python\`），
# 装上 CUDA 版 torch 之后约 4 GB。**它必须留在盘上、绝不能入库**——
# 一次 `git add -A` 就会把 4 GB 推进 GitHub。
python/
__pycache__/
*.pyc

# 本地配置与密钥
.env
.env.*
*.key
*.pem
secrets/
config.local.json

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
vs_out.txt
vs_err.txt
